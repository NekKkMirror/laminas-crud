{
    "scripts": {
        "serve": "php -S 0.0.0.0:${APP_PORT} -t public",
        "migrations:generate": "php vendor/bin/doctrine-migrations migrations:generate --configuration=module/Db/config/doctrine_migrations.php",
        "migrations:diff": "php vendor/bin/doctrine-migrations migrations:diff --configuration=module/Db/config/doctrine_migrations.php",
        "migrations:migrate": "php vendor/bin/doctrine-migrations migrations:migrate --configuration=module/Db/config/doctrine_migrations.php",
        "test": "vendor/bin/phpunit --configuration phpunit.xml",
        "cs-check": "vendor/bin/phpcs --standard=PSR12 module",
        "cs-fix": "vendor/bin/phpcbf --standard=PSR12 module",
        "static-analysis": "vendor/bin/phpstan analyse module",
        "docs:gen": "php swagger.php > public/swagger/swagger.json"
    },
    "require": {
        "php": "^8.1",
        "laminas/laminas-mvc": "^3.8",
        "laminas/laminas-router": "^3.4",
        "laminas/laminas-servicemanager": "^3.23",
        "laminas/laminas-view": "^2.36",
        "doctrine/orm": "^3.3",
        "doctrine/dbal": "^4.0",
        "symfony/cache": "^6.0",
        "symfony/console": "^6.0",
        "psr/log": "^3.0",
        "doctrine/migrations": "^3.9",
        "zircote/swagger-php": "^5.1",
        "doctrine/annotations": "^2.0",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "laminas/laminas-test": "^4.0",
        "laminas/laminas-developer-tools": "^2.0",
        "squizlabs/php_codesniffer": "^3.12",
        "phpstan/phpstan": "^2.1",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "Api\\": "module/Api/src/",
            "ApiTest\\": "module/Api/test/",
            "Db\\": "module/Db/src/"
        }
    }
}
